<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bg_card"
    android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
    <View android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="middle" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_chip" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
